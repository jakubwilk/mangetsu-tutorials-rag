# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/mangetsu_rag
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=password

# OVH AI Endpoints
# Każdy model ma osobny URL - pobierz z panelu OVH Public Cloud > AI Endpoints
OVH_AI_ENDPOINT=https://your-llm-endpoint.ai-endpoints.kepler.ai.cloud.ovh.net/v1
OVH_AI_API_KEY=your-ovh-api-key
OVH_AI_MODEL=Meta-Llama-3.1-70B-Instruct

# Embedding model (osobny endpoint)
OVH_AI_EMBEDDING_ENDPOINT=https://your-embedding-endpoint.ai-endpoints.kepler.ai.cloud.ovh.net/v1
OVH_AI_EMBEDDING_MODEL=Qwen3-Embedding-8B

# Rate limiting
DAILY_REQUEST_LIMIT=20

# External forum link
NEXT_PUBLIC_FORUM_URL=

# Auth (Discord OAuth) — wygeneruj AUTH_SECRET komendą: npx auth secret
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_TRUST_HOST=true

# n8n webhooks — panel administracyjny (aktywacja konta / usunięcie konta)
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.example.com/webhook
N8N_WEBHOOK_SECRET=
