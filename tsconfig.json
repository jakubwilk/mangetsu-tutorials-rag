{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "chat": ["./src/modules/chat/index"],
      "chat/*": ["./src/modules/chat/*"],
      "notices": ["./src/modules/notices/index"],
      "notices/*": ["./src/modules/notices/*"],
      "search": ["./src/modules/search/index"],
      "search/*": ["./src/modules/search/*"],
      "common": ["./src/modules/common/index"],
      "common/*": ["./src/modules/common/*"],
      "server/*": ["./src/server/*"],
      "data/*": ["./src/modules/common/data/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
